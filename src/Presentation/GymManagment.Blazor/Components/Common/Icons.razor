@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Class { get; set; } = "w-5 h-5";
    [Parameter] public int Size { get; set; } = 20;
}

<svg class="@Class"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true">
    @switch (Name.ToLowerInvariant())
    {
        case "dashboard":
            <rect width="7" height="9" x="3" y="3" rx="1" />
            <rect width="7" height="5" x="14" y="3" rx="1" />
            <rect width="7" height="9" x="14" y="12" rx="1" />
            <rect width="7" height="5" x="3" y="16" rx="1" />
            break;

        case "users":
        case "members":
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            break;

        case "plans":
        case "clipboard":
            <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
            <path d="M12 11h4" />
            <path d="M12 16h4" />
            <path d="M8 11h.01" />
            <path d="M8 16h.01" />
            break;

        case "memberships":
        case "id-card":
            <rect width="18" height="14" x="3" y="5" rx="2" />
            <circle cx="9" cy="11" r="2" />
            <path d="M7 16a2 2 0 0 1 4 0" />
            <path d="M15 10h2" />
            <path d="M15 14h2" />
            break;

        case "plus":
            <path d="M5 12h14" />
            <path d="M12 5v14" />
            break;

        case "search":
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
            break;

        case "edit":
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
            break;

        case "trash":
            <path d="M3 6h18" />
            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
            <line x1="10" x2="10" y1="11" y2="17" />
            <line x1="14" x2="14" y1="11" y2="17" />
            break;

        case "check":
            <path d="M20 6 9 17l-5-5" />
            break;

        case "x":
        case "close":
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
            break;

        case "alert":
        case "warning":
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
            <line x1="12" x2="12" y1="9" y2="13" />
            <line x1="12" x2="12.01" y1="17" y2="17" />
            break;

        case "arrow-left":
            <path d="m12 19-7-7 7-7" />
            <path d="M19 12H5" />
            break;

        case "calendar":
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
            <line x1="16" x2="16" y1="2" y2="6" />
            <line x1="8" x2="8" y1="2" y2="6" />
            <line x1="3" x2="21" y1="10" y2="10" />
            break;

        case "clock":
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
            break;

        case "dollar":
            <line x1="12" x2="12" y1="2" y2="22" />
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            break;

        case "menu":
            <line x1="4" x2="20" y1="12" y2="12" />
            <line x1="4" x2="20" y1="6" y2="6" />
            <line x1="4" x2="20" y1="18" y2="18" />
            break;

        case "refresh":
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
            <path d="M3 3v5h5" />
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
            <path d="M16 16h5v5" />
            break;

        case "dumbbell":
        default:
            <path d="m6.5 6.5 11 11" />
            <path d="m21 21-1-1a2 2 0 0 0-2.83 0l-1.42 1.42a2 2 0 0 0 0 2.83l1 1a2 2 0 0 0 2.83 0l1.42-1.42a2 2 0 0 0 0-2.83Z" />
            <path d="m3 3 1 1a2 2 0 0 0 2.83 0l1.42-1.42a2 2 0 0 0 0-2.83l-1-1a2 2 0 0 0-2.83 0L3 3a2 2 0 0 0 0 2.83Z" />
            <path d="m18 15 3-3" />
            <path d="m15 18 3-3" />
            <path d="m9 6-3 3" />
            <path d="m6 9-3 3" />
            break;
    }
</svg>

