@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="HandleCancel">
        <div class="modal-content-card" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="modal-title">
            <div class="modal-header">
                <h3 class="modal-title" id="modal-title">@Title</h3>
                <button type="button" class="modal-close-btn" @onclick="HandleCancel" aria-label="Close" disabled="@IsBusy">
                    <Icons Name="close" Size="18" />
                </button>
            </div>
            <div class="modal-body">
                <p class="mb-0 text-secondary">@Message</p>
                @if (ChildContent != null)
                {
                    <div class="mt-3">
                        @ChildContent
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-gym btn-gym-secondary" @onclick="HandleCancel" disabled="@IsBusy">
                    @CancelText
                </button>
                <button type="button"
                        class="@(IsDestructive ? "btn-gym btn-gym-danger" : "btn-gym btn-gym-primary")"
                        @onclick="HandleConfirm"
                        disabled="@IsBusy">
                    @if (IsBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Processing...</span>
                    }
                    else
                    {
                        @ConfirmText
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string Message { get; set; } = "Are you sure you want to proceed?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public bool IsDestructive { get; set; } = true;
    [Parameter] public bool IsBusy { get; set; } = false;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleConfirm()
    {
        if (!IsBusy && OnConfirm.HasDelegate)
        {
            await OnConfirm.InvokeAsync();
        }
    }

    private async Task HandleCancel()
    {
        if (!IsBusy && OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
}

