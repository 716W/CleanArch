@page "/membership-plans"
@implements IDisposable
@inject IMembershipPlanService MembershipPlanService
@inject NavigationManager Navigation

<div class="membership-plans-list-page">
    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="gym-alert gym-alert-success mb-3" role="alert">
            <Icons Name="check" Size="18" Class="text-success flex-shrink-0" />
            <div class="gym-alert-body">
                <div>@_successMessage</div>
            </div>
            <button type="button" class="btn-close ms-auto" @onclick="() => _successMessage = null" aria-label="Close"></button>
        </div>
    }

    @if (_apiException != null)
    {
        <ErrorMessage Exception="_apiException" OnRetry="LoadPlansAsync" />
    }

    <!-- Header & Filter Bar -->
    <div class="filter-bar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 flex-wrap">
            <div class="search-input-group">
                <span class="search-icon"><Icons Name="search" Size="16" /></span>
                <input type="text"
                       class="gym-input"
                       placeholder="Search plans by name..."
                       @bind="_searchTerm"
                       @bind:event="oninput" />
            </div>

            <div style="min-width: 150px;">
                <select class="gym-select" value="@(_activeOnlyFilter?.ToString() ?? "all")" @onchange="OnFilterChanged">
                    <option value="all">All Plans</option>
                    <option value="true">Active Only</option>
                    <option value="false">Inactive Only</option>
                </select>
            </div>

            <button type="button" class="btn-gym btn-gym-secondary" @onclick="LoadPlansAsync" title="Refresh">
                <Icons Name="refresh" Size="16" />
            </button>
        </div>

        <a href="membership-plans/create" class="btn-gym btn-gym-primary">
            <Icons Name="plus" Size="16" /> Create Plan
        </a>
    </div>

    <!-- Table Card -->
    <div class="gym-card">
        @if (_isLoading)
        {
            <LoadingIndicator Message="Loading membership plans..." />
        }
        else if (FilteredPlans.Count == 0)
        {
            <div class="p-4">
                @if (!string.IsNullOrWhiteSpace(_searchTerm) || _activeOnlyFilter.HasValue)
                {
                    <EmptyState Icon="search"
                                Title="No matching plans"
                                Description="No membership plans matched your search or status filter.">
                        <ActionButton>
                            <button type="button" class="btn-gym btn-gym-secondary btn-gym-sm" @onclick="ClearFilters">
                                Reset Filters
                            </button>
                        </ActionButton>
                    </EmptyState>
                }
                else
                {
                    <EmptyState Icon="plans"
                                Title="No membership plans defined"
                                Description="Create your first membership plan to begin accepting subscriptions.">
                        <ActionButton>
                            <a href="membership-plans/create" class="btn-gym btn-gym-primary btn-gym-sm">
                                <Icons Name="plus" Size="14" /> Create First Plan
                            </a>
                        </ActionButton>
                    </EmptyState>
                }
            </div>
        }
        else
        {
            <div class="gym-table-container">
                <table class="gym-table">
                    <thead>
                        <tr>
                            <th>Plan Name</th>
                            <th>Duration</th>
                            <th>Price</th>
                            <th>Max Freeze</th>
                            <th>Display Order</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in FilteredPlans)
                        {
                            <tr>
                                <td>
                                    <a href="membership-plans/@plan.Id" class="fw-semibold text-dark text-decoration-none">
                                        @plan.Name
                                    </a>
                                </td>
                                <td>@FormatDuration(plan.DurationInDays)</td>
                                <td class="fw-bold text-dark">$@plan.Price.ToString("N2")</td>
                                <td>@plan.MaxFreezeDays days</td>
                                <td>@plan.DisplayOrder</td>
                                <td><StatusBadge IsActive="@plan.IsActive" /></td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a href="membership-plans/@plan.Id" class="btn-gym btn-gym-secondary btn-gym-sm" title="View details">
                                            View
                                        </a>
                                        <a href="membership-plans/@plan.Id/edit" class="btn-gym btn-gym-secondary btn-gym-sm" title="Edit plan">
                                            <Icons Name="edit" Size="14" />
                                        </a>
                                        @if (plan.IsActive)
                                        {
                                            <button type="button"
                                                    class="btn-gym btn-gym-secondary btn-gym-sm"
                                                    @onclick="() => PromptToggleActive(plan, false)"
                                                    title="Deactivate plan">
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn-gym btn-gym-success btn-gym-sm"
                                                    @onclick="() => PromptToggleActive(plan, true)"
                                                    title="Activate plan">
                                                Activate
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="gym-card-footer justify-content-between">
                <span class="text-muted" style="font-size: 0.8125rem;">
                    Showing @FilteredPlans.Count of @_plans.Count plans
                </span>
            </div>
        }
    </div>
</div>

<ConfirmDialog IsOpen="_statusDialogOpen"
               Title="@(_dialogActionActivate ? "Activate Membership Plan" : "Deactivate Membership Plan")"
               Message="@(_dialogActionActivate
                   ? $"Activate plan '{_selectedPlan?.Name}'? Members will immediately be able to subscribe to this plan."
                   : $"Deactivate plan '{_selectedPlan?.Name}'? New subscriptions to this plan will be blocked. Existing subscriptions remain intact.")"
               ConfirmText="@(_dialogActionActivate ? "Activate" : "Deactivate")"
               IsDestructive="@(!_dialogActionActivate)"
               IsBusy="_isTogglingStatus"
               OnConfirm="ConfirmToggleActiveAsync"
               OnCancel="() => _statusDialogOpen = false" />

@code {
    private bool _isLoading = true;
    private bool _isTogglingStatus;
    private GymManagementApiException? _apiException;
    private string? _successMessage;

    private List<MembershipPlanResponse> _plans = new();
    private string _searchTerm = "";
    private bool? _activeOnlyFilter;

    private bool _statusDialogOpen;
    private bool _dialogActionActivate;
    private MembershipPlanResponse? _selectedPlan;
    private CancellationTokenSource _cts = new();

    private List<MembershipPlanResponse> FilteredPlans
    {
        get
        {
            var query = _plans.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(p => p.Name != null && p.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            if (_activeOnlyFilter.HasValue)
            {
                query = query.Where(p => p.IsActive == _activeOnlyFilter.Value);
            }

            return query.OrderBy(p => p.DisplayOrder).ThenBy(p => p.Name).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync()
    {
        _isLoading = true;
        _apiException = null;

        _cts.Cancel();
        _cts.Dispose();
        _cts = new CancellationTokenSource();

        try
        {
            var result = await MembershipPlanService.GetAllAsync(activeOnly: null, _cts.Token);
            _plans = result.ToList();
        }
        catch (GymManagementApiException ex)
        {
            _apiException = ex;
        }
        catch (OperationCanceledException)
        {
            // Cancelled
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (val == "true")
            _activeOnlyFilter = true;
        else if (val == "false")
            _activeOnlyFilter = false;
        else
            _activeOnlyFilter = null;
    }

    private void ClearFilters()
    {
        _searchTerm = "";
        _activeOnlyFilter = null;
    }

    private static string FormatDuration(int days) => days switch
    {
        1 => "1 Day",
        7 => "7 Days (1 Week)",
        14 => "14 Days (2 Weeks)",
        30 => "30 Days (1 Month)",
        90 => "90 Days (3 Months)",
        180 => "180 Days (6 Months)",
        365 => "365 Days (1 Year)",
        _ => $"{days} Days"
    };

    private void PromptToggleActive(MembershipPlanResponse plan, bool activate)
    {
        _selectedPlan = plan;
        _dialogActionActivate = activate;
        _statusDialogOpen = true;
    }

    private async Task ConfirmToggleActiveAsync()
    {
        if (_selectedPlan == null) return;
        _isTogglingStatus = true;

        try
        {
            if (_dialogActionActivate)
            {
                await MembershipPlanService.ActivateAsync(_selectedPlan.Id);
                _selectedPlan.IsActive = true;
                _successMessage = $"Plan '{_selectedPlan.Name}' has been activated.";
            }
            else
            {
                await MembershipPlanService.DeactivateAsync(_selectedPlan.Id);
                _selectedPlan.IsActive = false;
                _successMessage = $"Plan '{_selectedPlan.Name}' has been deactivated.";
            }

            _statusDialogOpen = false;
            _selectedPlan = null;
        }
        catch (GymManagementApiException ex)
        {
            _apiException = ex;
            _statusDialogOpen = false;
        }
        finally
        {
            _isTogglingStatus = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}

